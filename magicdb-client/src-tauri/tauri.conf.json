{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "com.magicdb",
  "productName": "MagicDB",
  "version": "1.0.0",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run start:web",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "MagicDB",
        "width": 1280,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "MagicDB"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "http": {
      "all": true
    }
  }
}
